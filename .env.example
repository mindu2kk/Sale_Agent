# ---------------------------------------------------------------------------
# AURA AI Sales Advisor - Environment Example
# Copy this file to `.env` for local development.
#
# Windows PowerShell:
#   Copy-Item .env.example .env
#
# macOS / Linux:
#   cp .env.example .env
#
# Do not commit `.env`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Product catalog
# ---------------------------------------------------------------------------

# Real catalog used by the storefront and AI Advisor.
PRODUCT_CATALOG_PATH=./data/product_catalog_real.csv

# ---------------------------------------------------------------------------
# AI workflow switches
# ---------------------------------------------------------------------------

# Keep the heavy external AI/research workflow disabled for normal local runs.
# The deterministic catalog advisor works without external API keys.
ENABLE_EXTERNAL_AI_WORKFLOW=false
AI_WORKFLOW_TIMEOUT_SECONDS=6

# Optional wording-only LLM pass.
# The deterministic response contract remains the source of truth.
ENABLE_LLM_DECISION_PHRASING=false
LLM_PHRASING_TIMEOUT_SECONDS=4

# Compare the current planner with a shadow route without changing user output.
AGENT_SHADOW_MODE=false

# Expose decision traces in API responses during debugging.
EXPOSE_DECISION_TRACE=false

# Optional append-only JSONL audit trail for complete harness trajectories.
# Leave blank locally.
HARNESS_AUDIT_PATH=

# ---------------------------------------------------------------------------
# Optional external API keys
# ---------------------------------------------------------------------------

# Required only when external AI/research workflows are enabled.
GOOGLE_API_KEY=your_google_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Optional model name for external LLM integrations.
LLM_MODEL=gemini-2.0-flash-exp

# ---------------------------------------------------------------------------
# API / frontend config
# ---------------------------------------------------------------------------

FRONTEND_URL=http://localhost:5173

# Optional bearer token for protected API deployments.
# For local development, keep this as a placeholder unless the backend is
# configured to require auth.
API_BEARER_TOKEN=change_me_for_deployment
