# ===================================
# Sales Copilot - Environment Variables
# ===================================

# HƯỚNG DẪN:
# 1. Copy file này thành .env
# 2. Thay thế các giá trị your_xxx bằng API keys thực của bạn
# 3. Không share file .env với người khác (có chứa API keys)

# ===================================
# API Keys (BẮT BUỘC)
# ===================================

# LlamaIndex Cloud API Key
# Đăng ký tại: https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Google Gemini API Key
# Đăng ký tại: https://ai.google.dev/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Tavily Search API Key
# Đăng ký tại: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Bearer Token để bảo mật API
# Tự tạo string bất kỳ (ví dụ: "my-secret-token-12345")
API_BEARER_TOKEN=your_secure_bearer_token_here

# ===================================
# Optional Configuration
# ===================================

# LLM Model (mặc định: gemini-2.0-flash-exp)
LLM_MODEL=gemini-2.0-flash-exp

# Frontend URL (mặc định: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ===================================
# NOTES
# ===================================
# - Đừng commit file .env vào git
# - File .env đã được thêm vào .gitignore
# - Mỗi người cần tạo .env riêng với API keys của họ
# - API keys miễn phí có giới hạn quota
